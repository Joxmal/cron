generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model monedas {
  id          Int      @id @default(autoincrement())
  bcv_EUR     Decimal  @default(0)
  bcv_USD     Decimal  @default(0)
  bcv_CNY     Decimal  @default(0)
  bcv_TRY     Decimal  @default(0)
  bcv_RUB     Decimal  @default(0)
  fecha       DateTime @unique @default(now())
  bnc_USD     Decimal  @default(0)
  bnc_USD_EUR Decimal  @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt  @default(now())
}
